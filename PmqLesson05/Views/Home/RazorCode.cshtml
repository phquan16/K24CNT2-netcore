@{
    ViewData["Title"] = "Cu phap Razor";
}
<h1>@ViewData["Title"]</h1>
<hr/>
@{
    var total = 7500;
    var myMessage = "Ban ngheo the -_-";
}
<p> Tai khoan cua ban: $ @total</p>
<P> @myMessage </P>

<h2>Cau truc IF...</h2>
<hr/>
    @if(total > 5000)
    {
        <p> Haha Co thang giau </p>
    }
    else if (total > 2000)
    {
        <p> May tam on</p>
    }
    else
    {
        <p> thao nao k co nguoi yeu</p>
    }

<h2> Cau truc For...</h2>
@for (int i = 0; i < 10; i++)
{   
    if(i % 2 == 0)
    {
        <span class="btn btn-danger">@i</span>
    }
    else
    {
        <span class="btn btn-success">@i</span>
    }

}
<h2> Mang </h2>
@{
    string[] myArray = { "1.jpg", "2.jpg", "3.jpg", "4.jpg", "5.jpg", "6.jpg" };
}
@foreach (var item in myArray)
{
    <img src="~/Images/@item" width="150" height="150" />
}