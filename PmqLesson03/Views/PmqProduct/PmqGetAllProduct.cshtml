@{
    ViewData["Title"] = "Danh sách sản phẩm";

    var products = ViewData["products"] as List<PmqLesson03.Models.PmqProduct>;
}

<div class="card">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (products != null)
                {
                    @foreach (var item in products)
                    {
                        <tr>
                            <td>@item.PmqProductID</td>
                            <td>@item.PmqProductName</td>
                            <td>@item.PmqYearRelease</td>
                            <td>@item.PmqPrice.ToString("N0") VNĐ</td>
                            <td>
                                <a href="#" class="btn btn-info btn-sm">Xem chi tiết</a>
                                <a href="#" class="btn btn-warning btn-sm">Sửa</a>
                                <a href="#" class="btn btn-danger btn-sm">Xóa</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>