@model PmqLesson11.Models.PmqEmployee

@{
    ViewData["Title"] = "Xóa Sinh Vien";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Nhân Viên</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-3" role="alert">
                        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa nhân viên này?
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-semibold py-2">Họ và Tên:</dt>
                        <dd class="col-sm-8 fw-bold text-danger py-2">@Html.DisplayFor(model => model.PmqName)</dd>

                        <dt class="col-sm-4 text-muted fw-semibold py-2">Email:</dt>
                        <dd class="col-sm-8 py-2">@Html.DisplayFor(model => model.PmqEmail)</dd>

                        <dt class="col-sm-4 text-muted fw-semibold py-2">Số Điện Thoại:</dt>
                        <dd class="col-sm-8 py-2">@Html.DisplayFor(model => model.PmqPhone)</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Hủy Bỏ
                    </a>
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill me-1"></i>Xác Nhận Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>