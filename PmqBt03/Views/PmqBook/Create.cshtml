@model PmqBt03.Models.PmqBook
@{
    ViewData["Title"] = "Create";
}
<h2>Thêm Mới Sách</h2>
<form action="" method="POST" enctype="mmultipart/form-data">
    <div class="form-group">
        <label asp-for="PmqTitle">Tên Sách</label>
        <input type="text" class="form-control" asp-for="PmqTitle" placeholder="Tên Sách" >
    </div>
    <div class="form-group">
        <label asp-for="PmqAuthorID">Tác Giả</label>
        <select asp-for="PmqAuthorID" class="form-control" asp-items="@ViewBag.authors">
            <option value="">Chọn Tác Giả</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="PmqAuthorID">Thể Loại</label>
        <select asp-for="PmqGenreId" class="form-control" asp-items="@ViewBag.genres">
            <option value="">Thể loại</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="PmqTitle">Giá Sách</label>
        <input type="text" class="form-control" asp-for="PmqPrice" placeholder="Giá Sách" >
    </div>
    <div class="form-group">
        <label asp-for="PmqTitle">Tổng số Trang</label>
        <input type="text" class="form-control" asp-for="PmqTotalPage" placeholder="Tổng số Trang" >
    </div>
    <div class="form-group">
        <label asp-for="PmqImages">Hình ảnh/Poster</label>
        <input type="file" class="form-control" asp-for="PmqImages" >
    </div>
    <div class="form-group">
        <label asp-for="PmqSumary">Giới Thiệu Ngắn</label>
        <textarea class="form-control" asp-for="PmqSumary" placeholder="Nội Dung Giới Thiệu Sách..."></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Lưu lại</button>
</form>
