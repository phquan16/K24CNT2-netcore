@model IEnumerable<PmqBt03.Models.PmqBook>
@foreach (var item in Model)
{
    <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
        <div class="thumbnail">
            <img src="@item.PmqImages" alt="" >
            <div class="caption">
                <h3>@item.PmqTitle</h3>
                <p>
                    Price: @item.PmqPrice
                </p>
            </div>
        </div>
    </div>
}