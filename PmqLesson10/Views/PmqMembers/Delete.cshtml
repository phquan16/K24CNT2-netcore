@model PmqLesson10.Models.PmqMember

@{
    ViewData["Title"] = "Xóa Thành viên";
}

<div class="container mt-4">
    <h2 class="text-danger">Xóa Thành viên</h2>
    <h5 class="text-muted">Bạn có chắc chắn muốn xóa bản ghi này khỏi cơ sở dữ liệu?</h5>
    <hr />

    <div class="card border-danger shadow-sm col-md-6">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Mã TV:</dt>
                <dd class="col-sm-8">@Model.MemberId</dd>

                <dt class="col-sm-4">Tài khoản:</dt>
                <dd class="col-sm-8">@Model.PmqUserName</dd>

                <dt class="col-sm-4">Họ và Tên:</dt>
                <dd class="col-sm-8">@Model.PmqFullName</dd>

                <dt class="col-sm-4">Email:</dt>
                <dd class="col-sm-8">@Model.PmqEmail</dd>

                <dt class="col-sm-4">Số điện thoại:</dt>
                <dd class="col-sm-8">@Model.PmqPhone</dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between">
            <form asp-action="Delete">
                <!-- BẮT BUỘC: Truyền ID qua thẻ ẩn -->
                <input type="hidden" asp-for="MemberId" />
                <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>
            </form>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</div>