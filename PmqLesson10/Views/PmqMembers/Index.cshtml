@model IEnumerable<PmqLesson10.Models.PmqMember>

@{
    ViewData["Title"] = "Danh sách Thành viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách Thành viên</h2>
        <a asp-action="Create" class="btn btn-success">+ Thêm mới</a>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Mã TV</th>
                <th>Tài khoản</th>
                <th>Họ và Tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Trạng thái</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MemberId</td>
                    <td>@item.PmqUserName</td>
                    <td>@item.PmqFullName</td>
                    <td>@item.PmqEmail</td>
                    <td>@item.PmqPhone</td>
                    <td>
                        @if (item.PmqStatus == true)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-star-fill"></i> Thành viên Tích cực (Đã đạt)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                <i class="bi bi-star"></i> Chưa đạt thành tích
                            </span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.MemberId" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.MemberId" class="btn btn-sm btn-info text-white">Chi tiết</a>
                        <a asp-action="Delete" asp-route-id="@item.MemberId" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>