@model PmqLesson10.Models.PmqMember

@{
    ViewData["Title"] = "Thêm mới Thành viên";
}

<div class="container mt-4">
    <h2>Thêm mới Thành viên</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <!-- Hiển thị tất cả lỗi nếu dữ liệu không hợp lệ -->
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="PmqUserName" class="form-label">Tài khoản (*)</label>
                    <input asp-for="PmqUserName" class="form-control" required />
                    <span asp-validation-for="PmqUserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PmqPassword" class="form-label">Mật khẩu (*)</label>
                    <input asp-for="PmqPassword" type="password" class="form-control" required />
                    <span asp-validation-for="PmqPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PmqFullName" class="form-label">Họ và Tên</label>
                    <input asp-for="PmqFullName" class="form-control" />
                    <span asp-validation-for="PmqFullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PmqEmail" class="form-label">Email</label>
                    <input asp-for="PmqEmail" type="email" class="form-control" />
                    <span asp-validation-for="PmqEmail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PmqPhone" class="form-label">Số điện thoại</label>
                    <input asp-for="PmqPhone" class="form-control" />
                    <span asp-validation-for="PmqPhone" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="PmqStatus" />
                    <label class="form-check-label" asp-for="PmqStatus">Kích hoạt tài khoản</label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success">Lưu / Thêm mới</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}