@model IEnumerable<PmqBt04.Models.PmqBt>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">Danh Sách Sản Phẩm </h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg"></i> Thêm mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã SP</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá bán</th>
                            <th>Giá giảm</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Hình ảnh</th>
                            <th>Danh mục</th>
                            <th>Mô tả</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.PmqId</td>
                                    <td>@item.PmqName</td>
                                    <td class="text-primary fw-bold">@item.PmqPrice.ToString("N0") VNĐ</td>
                                    <td class="text-danger">
                                        @(item.PmqSalePrice.HasValue ? item.PmqSalePrice.Value.ToString("N0") + " VNĐ" : "-")
                                    </td>
                                    <td>
                                        @if (item.PmqStatus == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (item.PmqStatus == "OutOfStock")
                                        {
                                            <span class="badge bg-warning text-dark">Out of stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.PmqStatus</span>
                                        }
                                    </td>
                                    <td>@item.PmqCreateDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <img src="~/images/@item.PmqImages" alt="@item.PmqName"
                                             class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;"
                                             onerror="this.onerror=null;this.src='https://via.placeholder.com/60';" />
                                    </td>
                                    <td><span class="badge bg-info text-dark">@item.PmqCategoryId</span></td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@item.PmqDescription">
                                        @item.PmqDescription
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.PmqId" class="btn btn-outline-warning" title="Sửa">
                                                Sửa
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.PmqId" class="btn btn-outline-info" title="Chi tiết">
                                                Xem
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.PmqId" class="btn btn-outline-danger" title="Xóa">
                                                Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    Chưa có dữ liệu sản phẩm nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>