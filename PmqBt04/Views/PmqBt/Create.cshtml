@model PmqBt04.Models.PmqBt

@{
    ViewData["Title"] = "Thêm mới sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Thêm mới sản phẩm</h4>
        </div>
        <div class="card-body">
            <!-- LƯU Ý THÊM enctype="multipart/form-data" -->
            <form asp-action="Create" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PmqId" class="form-label fw-bold">Mã sản phẩm</label>
                        <input asp-for="PmqId" class="form-control" placeholder="Ví dụ: PMQ006" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PmqName" class="form-label fw-bold">Tên sản phẩm</label>
                        <input asp-for="PmqName" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PmqPrice" class="form-label fw-bold">Giá bán</label>
                        <input asp-for="PmqPrice" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PmqSalePrice" class="form-label fw-bold">Giá khuyến mãi</label>
                        <input asp-for="PmqSalePrice" type="number" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PmqStatus" class="form-label fw-bold">Trạng thái</label>
                        <select asp-for="PmqStatus" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="OutOfStock">OutOfStock</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PmqCreateDate" class="form-label fw-bold">Ngày tạo</label>
                        <input asp-for="PmqCreateDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="row">
                    <!-- Ô CHỌN FILE ẢNH TỪ MÁY -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Chọn ảnh từ máy tính</label>
                        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PmqCategoryId" class="form-label fw-bold">Mã danh mục</label>
                        <input asp-for="PmqCategoryId" class="form-control" placeholder="CAT01" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PmqDescription" class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="PmqDescription" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-success">Lưu lại</button>
                </div>
            </form>
        </div>
    </div>
</div>