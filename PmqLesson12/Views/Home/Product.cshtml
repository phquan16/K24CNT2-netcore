@model IEnumerable<PmqLesson12.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <h2 class="mb-4">Danh sách sản phẩm</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm text-center p-3 border-0 rounded-3 bg-light">
                        <!-- Hiển thị ảnh sản phẩm -->
                        @if (!string.IsNullOrEmpty(item.PmqImages))
                        {
                            <img src="@item.PmqImages" class="card-img-top mx-auto rounded" alt="@item.PmqName" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="text-muted d-flex align-items-center justify-content-center bg-secondary bg-opacity-10 rounded" style="height: 180px;">
                                <span>Không có ảnh</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column justify-content-between px-0 pb-0">
                            <h5 class="card-title text-dark fw-bold fs-6">@item.PmqName</h5>
                            <div>
                                <p class="text-danger fw-bold mb-2">@item.PmqPrice.ToString("N0") đ</p>
                                <a asp-controller="PmqProduct" asp-action="Details" asp-route-id="@item.PmqId" class="btn btn-outline-primary btn-sm w-100">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Chưa có sản phẩm nào trong cơ sở dữ liệu! Bạn hãy vào trang <a asp-controller="PmqProduct" asp-action="Create" class="alert-link">Thêm mới sản phẩm</a> để tạo dữ liệu nhé.
        </div>
    }
</div>