@model IEnumerable<PmqLesson12.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <h2>Danh sách sản phẩm</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Thêm mới sản phẩm</a>
    </p>

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm theo tên hoặc mã sản phẩm..." />
            <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
        </div>
    </form>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Mã SP</th>
                <th>Tên sản phẩm</th>
                <th>Ảnh</th>
                <th>Giá gốc</th>
                <th>Giá KM</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.PmqId)</td>
                    <td>@Html.DisplayFor(modelItem => item.PmqName)</td>
                    <td style="width: 80px;">
                        @if (!string.IsNullOrEmpty(item.PmqImages))
                        {
                            <img src="@item.PmqImages" alt="Product Image" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                        }
                        else
                        {
                            <span class="text-muted small">Không có</span>
                        }
                    </td>
                    <td>@item.PmqPrice.ToString("N0") đ</td>
                    <td>@(item.PmqSalePrice.HasValue ? item.PmqSalePrice.Value.ToString("N0") + " đ" : "")</td>
                    <td>@Html.DisplayFor(modelItem => item.PmqStatus)</td>
                    <td>@item.PmqCreateDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.PmqId" class="btn btn-sm btn-warning">Sửa</a> |
                        <a asp-action="Details" asp-route-id="@item.PmqId" class="btn btn-sm btn-info">Chi tiết</a> |
                        <a asp-action="Delete" asp-route-id="@item.PmqId" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>