@model PmqLesson08Model.Models.PmqMember

@{
    ViewData["Title"] = "Sua thong tin sinh vien";
}

<form asp-action="PmqEdit" method="post">
    <div class="card p-3">
        <div class="card-header">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="PmqUserName" class="control-label"></label>
                        <input asp-for="PmqUserName" class="form-control" />
                        <span asp-validation-for="PmqUserName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PmqPassWord" class="control-label"></label>
                        <input asp-for="PmqPassWord" class="form-control" />
                        <span asp-validation-for="PmqPassWord" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PmqFullName" class="control-label"></label>
                        <input asp-for="PmqFullName" class="form-control" />
                        <span asp-validation-for="PmqFullName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PmqEmail" class="control-label"></label>
                        <input asp-for="PmqEmail" class="form-control" />
                        <span asp-validation-for="PmqEmail" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="form-group">
                <input type="submit" value="Cap nhap" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</form>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
