@{
    ViewData["Title"] = "Danh sach thanh vien";
    int num = 0;
}
<div class="card">
    <h1>@ViewData["Title"]</h1>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>#No.</th>
                <th>Member Id</th>
                <th>User Name</th>
                <th>Full Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in ViewBag.Members)
            {
                num++;
                <tr>
                    <th>@num</th>
                    <th>@member.PmqMemberId</th>
                    <th>@member.PmqUserName</th>
                    <th>@member.PmqFullName</th>
                    <th>@member.PmqEmail</th>
                </tr>
            }
        </tbody>
    </table>
</div>
